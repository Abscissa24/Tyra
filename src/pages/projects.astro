---
import Card from "@/components/Card.astro";
import Heading from "@/components/Heading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@cv";

const projectsDescription =
  "Academic, laboratory, and quality-focused work by Tyra Premraj — microbiology, immunology, molecular biology, and clinical biochemistry coursework with quality control and documentation practice.";
---

<BaseLayout title="Projects" description={projectsDescription}>
  <div class="container mx-auto my-24 xl:my-5">
    <Heading title="My Projects" />
    {
      projects.length > 0 ? (
        <div class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2">
          {projects.map(({ url, name, description, highlights, technologies }) => (
            <Card
              url={url}
              description={description}
              highlights={highlights}
              name={name}
              technologies={technologies}
            />
          ))}
        </div>
      ) : (
        <p class="text-black/80 dark:text-white/80">
          Projects are being added — check back soon.
        </p>
      )
    }
  </div>
</BaseLayout>
